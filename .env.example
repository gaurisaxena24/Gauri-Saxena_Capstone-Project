# ONE root .env for the whole app (frontend never sees any of this).

# DATABASE — required. A Postgres connection string. On Railway, attach a Postgres
# service to the same project and reference its DATABASE_URL as this service's
# DATABASE_URL (Railway does this automatically for services created via "+ New" in
# the same project). For local dev, point this at your own dev Postgres instance —
# never at the same database production uses.
DATABASE_URL=postgres://user:password@host:5432/database

# GROQ — the only AI provider
GROQ_API_KEY=
# Only set this if your Groq account actually has a vision-capable model
# (most standard accounts don't — verified directly against the real API).
# Leave blank and the app automatically falls back to local OCR + Groq text.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# TELEGRAM — required by the existing Telegram MCP/bot (both the
# Telegram-only flow and the web app's send step use this same bot).
TELEGRAM_BOT_TOKEN=your_token_here
# Still required by the original Telegram-only conversational flow's
# draft/approval tools (backend/tools/createDebtReminderDraft.ts) — the web
# app's send path does not use this, it sends to each person's own verified
# chat_id instead.
TELEGRAM_REVIEWER_CHAT_ID=your_chat_id_here

# GMAIL (optional) — lets you connect your Gmail account in Settings. See
# Google Cloud Console: enable the Gmail API, create an OAuth consent screen
# (External, Testing status, add your own Gmail as a test user — do not
# Publish, gmail.readonly is a restricted scope), then create an OAuth
# client (Web application) with an Authorized redirect URI matching
# GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client above.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
# One 32-byte key, base64-encoded — generate with `openssl rand -base64 32`.
# Encrypts the stored Gmail refresh token at rest. Never commit a real value.
CREDENTIAL_ENCRYPTION_KEY=
# Dev only — where the browser lands after the Google OAuth round trip. The
# backend doesn't serve the frontend in dev (only in production, where this
# is left unset and a relative redirect is correct instead). Also used as the
# explicit CORS origin once the session cookie is involved (see server.ts).
FRONTEND_URL=http://localhost:5173
# How often (minutes) the background job checks each connected user's Gmail for payment emails —
# independent of REMINDER_INTERVAL_MINUTES below. Optional, defaults to 5.
GMAIL_SCAN_INTERVAL_MINUTES=1

# APP
PORT=4000
NODE_ENV=development
